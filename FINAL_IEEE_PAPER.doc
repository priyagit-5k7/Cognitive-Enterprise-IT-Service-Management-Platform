.PAPER-CONTAINER
	{box-shadow: 0 0 10px rgba(0,0,0,0.1);}
pre
	{border-radius: 5px;
	overflow-x: auto;}

 /* Font Definitions */
 @font-face
	{font-family:"Cambria Math";
	panose-1:2 4 5 3 5 4 6 3 2 4;
	mso-font-charset:0;
	mso-generic-font-family:roman;
